# Copy to .env.local. Both come from your Trovy dashboard, under Developer API.
# Use the TEST pair: it reaches the sandbox and sends no real texts.

# Server only. Never prefix this with NEXT_PUBLIC_.
TROVY_SECRET_KEY=

# Safe in the browser. Add http://localhost:3000 to this key's allowed origins.
NEXT_PUBLIC_TROVY_PUBLISHABLE_KEY=
